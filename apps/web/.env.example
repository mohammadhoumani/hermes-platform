# Copy to .env.local and fill in. Never commit real values.
# The web app only ever uses the publishable (anon) key. The service role key is NOT used anywhere in the web app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Test mode (local development and Playwright only; ignored by production builds).
# 1 = use built-in fixture data instead of Supabase. See docs/M1_REPORT.md.
# HERMES_TEST_MODE=1
